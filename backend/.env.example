# Server
PORT=5000
NODE_ENV=development

# Database (MySQL 8+)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=marketplace_db
DB_USER=root
DB_PASSWORD=

# Connection pool
DB_POOL_LIMIT=10

# Auth
JWT_SECRET=replace_this_with_a_long_random_string
JWT_EXPIRES_IN=7d

# CORS - the origin the frontend is served from during development
CLIENT_ORIGIN=http://localhost:5000

# Auction scheduler tick interval, in milliseconds (opens/closes due auctions)
AUCTION_SCHEDULER_INTERVAL_MS=15000

# Optional: a real image-recognition/vision provider's API key for the Scan
# feature's "Image Search" tab. Leave unset in development — the app
# correctly reports "Scan service not configured." instead of faking a
# result when this is empty (see backend/services/scan.service.js).
SCAN_IMAGE_PROVIDER_API_KEY=
